  "soal_html": "    <div class=\"soal-header\">\r\n        <div class=\"d-flex justify-content-between align-items-center\">\r\n            <div>\r\n                <h4>Soal 29 dari 110</h4>\r\n                <span class=\"badge bg-primary\">Tes Wawasan Kebangsaan (TWK)</span>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <div class=\"soal-content\">\r\n                    <div class=\"soal-text\">\r\n                Seorang ASN di bagian pelayanan publik mendapati seorang warga yang ingin mengurus administrasi namun berkasnya tidak lengkap. Warga tersebut mencoba menyelipkan sejumlah uang ke dalam map dengan harapan prosesnya tetap bisa berjalan karena ia sangat membutuhkannya untuk urusan mendesak. Tindakan paling tepat yang mencerminkan integritas tinggi adalah ...            </div>\r\n        \r\n            </div>\r\n\r\n    <form id=\"jawabanForm\">\r\n                        <div class=\"pilihan-jawaban\">\r\n\r\n                    <input type=\"radio\"\r\n                        name=\"jawaban\"\r\n                        id=\"pilihanA\"\r\n                        value=\"a\"\r\n                        >\r\n\r\n                    <label for=\"pilihanA\" class=\"pilihan-label\">\r\n\r\n                        <div class=\"pilihan-huruf\">\r\n                            A                        </div>\r\n\r\n                        <div class=\"pilihan-content\">\r\n\r\n                                                            <div class=\"pilihan-text\">\r\n                                    Menerima uang tersebut dengan niat membantu warga, namun tetap meminta warga melengkapi berkas di kemudian hari                                </div>\r\n                            \r\n                            \r\n                        </div>\r\n\r\n                    </label>\r\n                </div>\r\n\r\n                        <div class=\"pilihan-jawaban\">\r\n\r\n                    <input type=\"radio\"\r\n                        name=\"jawaban\"\r\n                        id=\"pilihanB\"\r\n                        value=\"b\"\r\n                        >\r\n\r\n                    <label for=\"pilihanB\" class=\"pilihan-label\">\r\n\r\n                        <div class=\"pilihan-huruf\">\r\n                            B                        </div>\r\n\r\n                        <div class=\"pilihan-content\">\r\n\r\n                                                            <div class=\"pilihan-text\">\r\n                                    Menolak uang tersebut dengan tegas dan meminta warga pulang untuk melengkapi berkas sesuai prosedur yang berlaku                                </div>\r\n                            \r\n                            \r\n                        </div>\r\n\r\n                    </label>\r\n                </div>\r\n\r\n                        <div class=\"pilihan-jawaban\">\r\n\r\n                    <input type=\"radio\"\r\n                        name=\"jawaban\"\r\n                        id=\"pilihanC\"\r\n                        value=\"c\"\r\n                        >\r\n\r\n                    <label for=\"pilihanC\" class=\"pilihan-label\">\r\n\r\n                        <div class=\"pilihan-huruf\">\r\n                            C                        </div>\r\n\r\n                        <div class=\"pilihan-content\">\r\n\r\n                                                            <div class=\"pilihan-text\">\r\n                                    Menolak uang tersebut, menjelaskan prosedur secara santun, serta memberikan arahan atau solusi bagaimana warga bisa melengkapi berkas dengan cepat                                </div>\r\n                            \r\n                            \r\n                        </div>\r\n\r\n                    </label>\r\n                </div>\r\n\r\n                        <div class=\"pilihan-jawaban\">\r\n\r\n                    <input type=\"radio\"\r\n                        name=\"jawaban\"