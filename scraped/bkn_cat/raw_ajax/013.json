  "soal_html": "    <div class=\"soal-header\">\r\n        <div class=\"d-flex justify-content-between align-items-center\">\r\n            <div>\r\n                <h4>Soal 13 dari 110</h4>\r\n                <span class=\"badge bg-primary\">Tes Wawasan Kebangsaan (TWK)</span>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <div class=\"soal-content\">\r\n                    <div class=\"soal-text\">\r\n                Pasal 29 UUD 1945 ayat (2) menyatakan negara menjamin kemerdekaan tiap-tiap penduduk untuk memeluk agamanya masing-masing dan beribadat menurut agama dan kepercayaannya itu. Oleh karena itu kebebasan beragama diartikan sebagai?            </div>\r\n        \r\n            </div>\r\n\r\n    <form id=\"jawabanForm\">\r\n                        <div class=\"pilihan-jawaban\">\r\n\r\n                    <input type=\"radio\"\r\n                        name=\"jawaban\"\r\n                        id=\"pilihanA\"\r\n                        value=\"a\"\r\n                        >\r\n\r\n                    <label for=\"pilihanA\" class=\"pilihan-label\">\r\n\r\n                        <div class=\"pilihan-huruf\">\r\n                            A                        </div>\r\n\r\n                        <div class=\"pilihan-content\">\r\n\r\n                                                            <div class=\"pilihan-text\">\r\n                                    Kebebasan yang bersumber pada martabat manusia sebagai mahluk ciptaan Tuhan                                </div>\r\n                            \r\n                            \r\n                        </div>\r\n\r\n                    </label>\r\n                </div>\r\n\r\n                        <div class=\"pilihan-jawaban\">\r\n\r\n                    <input type=\"radio\"\r\n                        name=\"jawaban\"\r\n                        id=\"pilihanB\"\r\n                        value=\"b\"\r\n                        >\r\n\r\n                    <label for=\"pilihanB\" class=\"pilihan-label\">\r\n\r\n                        <div class=\"pilihan-huruf\">\r\n                            B                        </div>\r\n\r\n                        <div class=\"pilihan-content\">\r\n\r\n                                                            <div class=\"pilihan-text\">\r\n                                    Kebebasan untuk menentukan dan memilih agama yang dianut serta berpindah-pindah                                </div>\r\n                            \r\n                            \r\n                        </div>\r\n\r\n                    </label>\r\n                </div>\r\n\r\n                        <div class=\"pilihan-jawaban\">\r\n\r\n                    <input type=\"radio\"\r\n                        name=\"jawaban\"\r\n                        id=\"pilihanC\"\r\n                        value=\"c\"\r\n                        >\r\n\r\n                    <label for=\"pilihanC\" class=\"pilihan-label\">\r\n\r\n                        <div class=\"pilihan-huruf\">\r\n                            C                        </div>\r\n\r\n                        <div class=\"pilihan-content\">\r\n\r\n                                                            <div class=\"pilihan-text\">\r\n                                    Kebebasan dalam menjalankan ibadah kapan saja dan dimana saja                                </div>\r\n                            \r\n                            \r\n                        </div>\r\n\r\n                    </label>\r\n                </div>\r\n\r\n                        <div class=\"pilihan-jawaban\">\r\n\r\n                    <input type=\"radio\"\r\n                        name=\"jawaban\"\r\n                        id=\"pilihanD\"\r\n                        value=\"d\"\r\n                        >\r\n\r\n                    <label for=\"pilihanD\" class=\"pilihan-label\">\r\n\r\n                        <div class=\"pilihan-huruf\">\r\n                            D   